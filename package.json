{
  "name": "fire-fight-2",
  "version": "0.1.0",
  "description": "FIRE FIGHT 2 — the WebXR fireball-boxing sequel: Rave Raid folded in as a mode, a shared social club that launches everything, paintable mannequin fighters, and next-gen dark desert arenas. Built on the Immersive Web SDK.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "server:pub": "node server/pub.mjs",
    "check:wrap": "node tools/wrap-check.mjs",
    "check:paint": "node tools/paint-wire-check.mjs",
    "check:grammar": "node tools/grammar-check.mjs",
    "check:pages": "node tools/pages-check.mjs",
    "check:desert": "node tools/desert-check.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "firebase": "^12.14.0",
    "livekit-client": "^2.19.2",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@types/three": "0.184.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0"
  }
}
